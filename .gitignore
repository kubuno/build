# ─────────────────────────────────────────────────────────────
# Kubuno — files that are NOT versioned (build artefacts, data, secrets).
# Only SOURCE CODE is committed; anything that can be regenerated is excluded.
# ─────────────────────────────────────────────────────────────

# Rust — build artefacts
/target/
**/target/

# Node — dependencies
node_modules/
**/node_modules/

# Frontend — build output
/frontend/dist/
/frontend/dist-modules/
*.tsbuildinfo

# Generated packages (.kbpkg and legacy system packages)
/dist/
*.kbpkg
*.deb
*.rpm

# build scripts — local state
/.build_state
/.build_number

# Runtime data & logs
/data/
nohup.out
*.log

# Secrets & local configuration (only the .example files are kept)
.env
.env.*
!.env.example
/config.toml
!config.toml.example
*.pem
*.key
*.p12
*.pfx
*.keystore

# Local agent / editor state
/.claude/
.vs/
.DS_Store
.idea/
.vscode/
*.swp

# Deliberately VERSIONED: Cargo.lock, .sqlx/ (sqlx query cache, needed to build
# without a database in CI), migrations/.
